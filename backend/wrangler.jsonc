{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "al-quran-research",
  "main": "cors-entry.js",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.6-flash"
  }
  // Chat connection recovery: keep the public workers.dev route explicitly enabled.
}
