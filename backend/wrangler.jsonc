{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "al-quran-research",
  "main": "cors-entry.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.6-flash"
  }
  // Production D1 activation:
  // Add:
  // "d1_databases": [{
  //   "binding": "DB",
  //   "database_name": "<CREATE_D1_DATABASE_NAME>",
  //   "database_id": "<CREATE_D1_DATABASE_ID>"
  // }]
  // Do not invent a database ID; activate only after the real D1 database exists.
}
